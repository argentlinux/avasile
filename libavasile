export ISO_EFI_DIR="${ISO_ROOT_DIR}/efi/boot"
export ISO_RSYNC_TARGET="${ISO_ROOT_DIR}/rootfs"
export ISO_RSYNC_SOURCE="/tmp/${ISO_ROOT_DIR}"
export ISO_CDROOT_DIR="${ISO_ROOT_DIR}/CDroot"
export ISO_REALFS_DIR="${ISO_CDROOT_DIR}/LiveOS"
export ISO_SQUASHFS_DIR="${ISO_ROOT_DIR}/LiveOS"

# Repository and Configuration Paths
export PORTAGE_MAIN_DIR="/var/db/repos/gentoo"
export ARGENT_MAIN_DIR="${ARGENT_MAIN_DIR:-/var/db/repos/argent-ws}"
export PORTAGE_LINK_CONFDIR="/etc/portage"
export PORTAGE_MAIN_CONF="${PORTAGE_MAIN_CONF:-00-main.conf}"
export PORTAGE_GITDIR="${PORTAGE_GITDIR:-/opt/argentws-build/conf/intel/portage}"
export PORTAGE_MAIN_CONFDIR="${PORTAGE_MAIN_CONFDIR:-/opt/argentws-build}"
export PORTAGE_REPO="${PORTAGE_REPO:-https://gitlab.com/argent/argentws-build.git}"
export PORTAGE_PROFILE="${PORTAGE_PROFILE:-default/linux/amd64/23.0/desktop/plasma/systemd}"

export ISO_BINPKGS_SOURCE="${ISO_BINPKGS_SOURCE:-/home/work/packages_argent_making/buildchroot_argentx64/var/cache/binpkgs}"
export ISO_BINPKGS_TARGET="${ISO_BINPKGS_TARGET:-/var/cache/binhost/binhost-main}"

export ISO_LIVE_CONF="${ISO_LIVE_CONF:-${PORTAGE_LINK_CONFDIR}/make.conf/zz-live.conf}"
export ISO_INSTALL_MASK="${ISO_INSTALL_MASK:-/usr/share/doc /usr/share/man /usr/share/info /usr/share/gtk-doc /usr/share/devhelp /usr/share/help /usr/lib/debug /usr/src/debug *.la *.a -libgcc.a -libgcc_eh.a -libgcov.a -libc_nonshared.a -libmvec_nonshared.a}"

declare -A AVASILE_MODE_CONF=(
	[binpkgmode]="make.conf.amd64-user"
	[mixedbinsrc]="make.conf.amd64-devel"
	[srcmode]="make.conf.amd64-srcmode"
	[srccustom]="make.conf.amd64-custom"
)

declare -A AVASILE_MODE_NAME=(
	[binpkgmode]="user mode (binary packages)"
	[mixedbinsrc]="mixed binary/source mode (devmode)"
	[srcmode]="source mode"
	[srccustom]="custom source mode"
)

# =============================================================================
# CORE SYSTEM FUNCTIONS
# =============================================================================

die() {
	eerror "$*"
	exit 1
}

short_pause() {
	sleep "${1:-1}"
}

kernel_check() {
	# Check if host kernel has required modules for avasile
	local required_configs=(
		'CONFIG_OVERLAY_FS='
		'CONFIG_SQUASHFS='
		'CONFIG_BLK_DEV_LOOP='
	)
	
	local missing_configs=()
	for config in "${required_configs[@]}"; do
		if ! zgrep -q "${config}" /proc/config.gz; then
			missing_configs+=("${config}")
		fi
	done
	
	if [[ ${#missing_configs[@]} -eq 0 ]]; then
		einfo "Kernel configuration check passed"
		short_pause
	else
		eerror "Vasile requires the following kernel modules:"
		for config in "${missing_configs[@]}"; do
			eerror "  - ${config}"
		done
		die "Please rebuild your kernel with these options enabled"
	fi
}

checkmode() {
	local make_conf_path="${PORTAGE_LINK_CONFDIR}/make.conf"
	local avasile_mode

	if [[ -d "${make_conf_path}" ]]; then
		avasile_mode=$(readlink -f "${make_conf_path}/$(find_make_conf_name)")
	else
		avasile_mode=$(readlink -f "${make_conf_path}")
	fi

	case "${avasile_mode}" in
		"${PORTAGE_MAIN_CONFDIR}/conf/intel/portage/make.conf.amd64-user")
			echo "$0 is on --usermode"
			;;
		"${PORTAGE_MAIN_CONFDIR}/conf/intel/portage/make.conf.amd64-devel")
			echo "$0 is on --devmode!"
			;;
		"${PORTAGE_MAIN_CONFDIR}/conf/intel/portage/make.conf.amd64-srcmode")
			echo "$0 is on --srcmode!"
			;;
		"${PORTAGE_MAIN_CONFDIR}/conf/intel/portage/make.conf.amd64-custom")
			echo "$0 is on your own custom mode!"
			;;
		*)
			echo "$0 is not on any known modes"
			;;
	esac
}

verify_root_priv() {
	# Verify root privileges for mount and chroot operations
	[[ "${UID}" == "0" ]] && return 0

	eerror "Root privileges required for this operation"
	echo
	command -v sudo >/dev/null 2>&1 || die "sudo not available. Please run as root"

	einfo "Attempting to restart with sudo..."
	exec sudo "$0" "${AVASILE_ARGV[@]}"
}

live_check() {
	# Prevent execution in live environment
	if [[ -L /dev/mapper/live-base ]]; then
		die "Avasile cannot run on a live ISO, boot an installed system instead"
	fi
}

find_make_conf_name() {
	local make_conf_path="${PORTAGE_LINK_CONFDIR}/make.conf"
	local confname

	for confname in 00-main.conf main.conf 00-argent.conf ; do
		if [[ -e "${make_conf_path}/${confname}" || -L "${make_conf_path}/${confname}" ]] ; then
			echo "${confname}"
			return 0
		fi
	done

	echo "${PORTAGE_MAIN_CONF}"
}

ensure_make_conf_local() {
	local conf_local="/etc/portage/make.conf.local"
	if [[ ! -f "${conf_local}" ]]; then
		touch "${conf_local}"
		einfo "Created empty ${conf_local}"
	fi
}

set_make_conf_symlink() {
	local conf_variant="${1}"
	local make_conf_path="${PORTAGE_LINK_CONFDIR}/make.conf"

	if [[ -L "${make_conf_path}" || -f "${make_conf_path}" ]]; then
		rm -f "${make_conf_path}"
	fi

	mkdir -p "${make_conf_path}"

	ln -sf "${PORTAGE_GITDIR}/${conf_variant}" "${make_conf_path}/$(find_make_conf_name)"
}

checksum_chroot_verify() {
	# Verify core squashfs integrity
	if [[ ! -f "${CORE_SQUASHFS}" || ! -f "${CORE_SQUASHFS_MD5}" ]]; then
		eerror "Missing squashed chroot or checksum file"
		die "Expected files: ${CORE_SQUASHFS}, ${CORE_SQUASHFS_MD5}"
	fi

	einfo "Found squashed chroot and checksum file"
	md5sum -c "${CORE_SQUASHFS_MD5}" >/dev/null 2>&1 || die "Squashed chroot checksum verification failed"
	einfo "Squashed chroot checksum verification passed"
	short_pause
}

# =============================================================================
# CHROOT ENVIRONMENT MANAGEMENT
# =============================================================================

chroot_setup() {
	# Create fresh overlay mount environment
	mkdir -p "${READ_ONLY_DIR}" "${READ_WRITE_DIR}" "${WORK_DIR}" "${OVERLAY_DIR}" || return 1
	chroot_mount
}

umount_chroot() {
	# Unmount chroot overlay filesystem
	local mount_points=(
		"${OVERLAY_DIR}/proc"
		"${OVERLAY_DIR}/sys"
		"${OVERLAY_DIR}/dev/pts"
		"${OVERLAY_DIR}/dev/shm"
		"${OVERLAY_DIR}/dev"
		"${OVERLAY_DIR}/tmp"
		"${OVERLAY_DIR}/var/cache/binpkgs"
		"${OVERLAY_DIR}/var/cache/distfiles"
		"${OVERLAY_DIR}"
		"${READ_ONLY_DIR}"
	)
	
	for mount_point in "${mount_points[@]}"; do
		umount -l "${mount_point}" >/dev/null 2>&1
	done
}

chroot_mount() {
    # Mount core squashfs in overlay configuration
    mount -t squashfs "${CORE_SQUASHFS}" "${READ_ONLY_DIR}" || return 1
    mount -t overlay \
        -o lowerdir="${READ_ONLY_DIR}",upperdir="${READ_WRITE_DIR}",workdir="${WORK_DIR}" \
        overlay "${OVERLAY_DIR}" || return 1

    mkdir -p "${OVERLAY_DIR}/var/cache/binpkgs"
    mkdir -p "${OVERLAY_DIR}/var/cache/distfiles"
    mount -o bind,ro packages "${OVERLAY_DIR}/var/cache/binpkgs" || return 1
    mount -o bind,ro distfiles "${OVERLAY_DIR}/var/cache/distfiles" || return 1
    
    # Mount virtual filesystems
    mount -t proc proc "${OVERLAY_DIR}/proc"
    mount -t sysfs sysfs "${OVERLAY_DIR}/sys"
    mount -t devtmpfs \
        -o relatime,size=3055348k,nr_inodes=763837,mode=755 \
        none "${OVERLAY_DIR}/dev"
    mount -t devpts \
        -o nosuid,noexec,relatime,gid=5,mode=620 \
        none "${OVERLAY_DIR}/dev/pts"
    mount -t tmpfs \
        -o nosuid,nodev \
        none "${OVERLAY_DIR}/dev/shm"
    mount -t tmpfs \
        -o nosuid,nodev,noexec \
        none "${OVERLAY_DIR}/tmp"
}

chroot_tree_sync() {
	# Initialize portage tree and overlay in chroot
	chroot "${OVERLAY_DIR}" su - "${BUILD_CHROOT_USER}" -c "${BUILD_SOURCE_SETUP}"
}

chroot_emerge() {
	# Build and install packages in chroot environment
	einfo "Starting package build process..."
	short_pause
	chroot "${OVERLAY_DIR}" su - "${BUILD_CHROOT_USER}" -c "emerge -kav $*"
}

chrootx64_iso() {
	# Interactive chroot shell for build adjustments
	einfo "========================================"
	einfo "DROPPING YOU TO A ROOT SHELL"
	einfo "BUILD ENVIRONMENT READY"
	einfo "========================================"
	einfo "Available actions:"
	einfo "- Fix build failures"
	einfo "- Adjust portage configuration"
	einfo "- Test USE flags and keywords"
	einfo "- Commit your changes before exit"
	einfo "========================================"
	
	chroot "${OVERLAY_DIR}" su - "${BUILD_CHROOT_USER}"
}

regenerate_cache() {
	env-update && source /etc/profile
}

chroot_pkg_build() {
	# Main package building workflow
	local build_rc

	verify_root_priv
	kernel_check
	checksum_chroot_verify

	if ! chroot_setup || ! chroot_tree_sync; then
		eerror "The build chroot could not be set up, unmounting it"
		umount_chroot
		return 1
	fi

	chroot_emerge "$@"
	build_rc=$?
	chrootx64_iso
	umount_chroot
	return "${build_rc}"
}

# =============================================================================
# ISO CREATION FUNCTIONS
# =============================================================================

iso_mount() {
	# Mount ISO image core filesystems
	mkdir -p "${ISO_RSYNC_TARGET}${ISO_BINPKGS_TARGET}"

	local mount_points=(
		"${ISO_BINPKGS_SOURCE}:${ISO_RSYNC_TARGET}${ISO_BINPKGS_TARGET}:bind"
		"/etc/resolv.conf:${ISO_RSYNC_TARGET}/etc/resolv.conf:bind"
		"proc:${ISO_RSYNC_TARGET}/proc:proc"
		"sysfs:${ISO_RSYNC_TARGET}/sys:sysfs"
		"devtmpfs:${ISO_RSYNC_TARGET}/dev:devtmpfs:-o relatime,size=3055348k,nr_inodes=763837,mode=755"
		"devpts:${ISO_RSYNC_TARGET}/dev/pts:devpts:-o nosuid,noexec,relatime,gid=5,mode=620"
		"tmpfs:${ISO_RSYNC_TARGET}/dev/shm:tmpfs:-o nosuid,nodev"
		"tmpfs:${ISO_RSYNC_TARGET}/tmp:tmpfs:-o nosuid,nodev,noexec"
	)
	
	for mount_spec in "${mount_points[@]}"; do
		IFS=':' read -r source target fstype options <<< "${mount_spec}"
		if [[ -n "${options}" ]]; then
			mount -t "${fstype}" ${options} none "${target}"
		elif [[ "${fstype}" == "bind" ]]; then
			if [[ "${target}" == *"${ISO_BINPKGS_TARGET}" ]]; then
				mount -o bind,ro "${source}" "${target}"
			else
				mount -o bind "${source}" "${target}"
			fi
		else
			mount -t "${fstype}" "${fstype}" "${target}"
		fi
	done
}

iso_umount() {
	# Unmount ISO image core filesystems
	local mount_points=(
		"${ISO_RSYNC_TARGET}/proc"
		"${ISO_RSYNC_TARGET}/sys"
		"${ISO_RSYNC_TARGET}/dev/pts"
		"${ISO_RSYNC_TARGET}/dev/shm"
		"${ISO_RSYNC_TARGET}/dev"
		"${ISO_RSYNC_TARGET}/tmp"
		"${ISO_RSYNC_TARGET}${ISO_BINPKGS_TARGET}"
		"${ISO_RSYNC_TARGET}/etc/resolv.conf"
	)
	
	for mount_point in "${mount_points[@]}"; do
		umount -l "${mount_point}" >/dev/null 2>&1
	done
}

isoumountall() {
	iso_umount
	umount -l "${ISO_RSYNC_TARGET}" >/dev/null 2>&1
	umount -l "${ISO_RSYNC_SOURCE}" >/dev/null 2>&1
}

isozerofree() {
	local img="${ISO_RSYNC_TARGET}.img"
	local tries=0

	sync
	while mountpoint -q "${ISO_RSYNC_TARGET}" && [[ ${tries} -lt 10 ]] ; do
		umount "${ISO_RSYNC_TARGET}" >/dev/null 2>&1 || short_pause
		tries=$((tries + 1))
	done

	if mountpoint -q "${ISO_RSYNC_TARGET}" ; then
		ewarn "${ISO_RSYNC_TARGET} is still busy, falling back to lazy unmount"
		ewarn "free space will not be zeroed, the squashfs will be larger than needed"
		umount -l "${ISO_RSYNC_TARGET}" >/dev/null 2>&1
		return 1
	fi

	if ! command -v zerofree > /dev/null 2>&1 ; then
		ewarn "sys-fs/zerofree is not installed, free space will not be zeroed"
		ewarn "deleted packages stay in ${img} and do not compress correctly"
		return 1
	fi

	einfo "Zeroing free space in ${img}"
	zerofree -v "${img}" || ewarn "zerofree failed on ${img}, continuing anyway"
}

iso_tree_sync() {
	# Initialize portage tree and overlay in ISO environment
	chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "${ISO_BINARY_SETUP}"
}

iso_initrd_gen() {
	# Generate ISO initramfs with live boot modules
	rm -f "${ISO_RSYNC_TARGET}/boot/${ISO_RAMFS_NAME}"
	chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "${ISO_RAMFS_CMD}"
}

iso_efi_gen() {
	# Generate EFI bootloader
	chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "${ISO_EFI_CMD}"
}

iso_grubcore_gen() {
	# Generate GRUB chainloader for unetbootin compatibility
	chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "${ISO_CHAINLOAD_CMD}"
}

iso_units_enable() {
	# Enable live ISO system services
	set -x
	
	local services=(
		"argentlive"
		"argent-config-vbox"
		"avahi-daemon"
		"cups"
		"dkms"
		"dm-event"
		"lvm2-monitor"
		"NetworkManager"
		"ModemManager"
		"sddm"
		"virtualbox-guest-additions"
	)
	
	# Enable system services
	for service in "${services[@]}"; do
		chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "systemctl enable ${service}"
	done

	chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c \
		"systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service"
	
	# Configure networking
	chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "rm -f /etc/resolv.conf"
	chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c \
		"ln -s /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf"

	set +x
}

isoinstallmask() {
	local conf_dir
	conf_dir="$(dirname "${ISO_LIVE_CONF}")"

	if ! chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "test -d '${conf_dir}'" ; then
		eerror "${conf_dir} is missing inside the ISO chroot"
		exit 1
	fi

	einfo "We're adding the live INSTALL_MASK: ${ISO_LIVE_CONF}"
	chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "printf 'INSTALL_MASK=\"\${INSTALL_MASK} %s\"\n' '${ISO_INSTALL_MASK}' > '${ISO_LIVE_CONF}'"
}

isoinstallmaskremove() {
	einfo "Removing the live INSTALL_MASK: ${ISO_LIVE_CONF}"
	chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "rm -f '${ISO_LIVE_CONF}'"
}

isoosrelease() {
	local src="${ISO_RSYNC_TARGET}/usr/lib/argent/os-release"

	if [[ ! -f "${src}" ]]; then
		ewarn "${src} is missing, os-release is left as it is"
		return 1
	fi

	einfo "Writing Argent os-release"
	cp -f "${src}" "${ISO_RSYNC_TARGET}/usr/lib/os-release"
	rm -f "${ISO_RSYNC_TARGET}/etc/os-release"
	cp -f "${src}" "${ISO_RSYNC_TARGET}/etc/os-release"
}

isoupdatedone() {
	einfo "Rebuilding linker cache"
	chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "ldconfig ; systemd-hwdb update ; journalctl --update-catalog ; touch /etc/.updated /var/.updated" \
		|| ewarn "Could not update linker cache and systemd stuff"
}

iso_customize() {
	# Interactive ISO environment setup
	einfo "========================================"
	einfo "ISO ENVIRONMENT SETUP"
	einfo "========================================"
	
	if [[ $# -eq 0 ]]; then
		einfo "Interactive mode:"
		einfo "- Install apps and targets"
		einfo "- Configure desktop environment"
		einfo "- Exit when finished"
		einfo "========================================"
		
		chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}"
		chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "umount -f /mnt/argent_efipart/dev/* 2>/dev/null || true"
		chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "env-update"
	else
		einfo "Automated installation mode"
		einfo "Installing packages from provided lists..."
		
		# Clean up previous package list
		if [[ -e "${ISO_RSYNC_TARGET}/ISO_Installed_Packages" ]]; then
			rm -f "${ISO_RSYNC_TARGET}/ISO_Installed_Packages"
		fi
		
		# Combine all package lists
		for package_list in "$@"; do
			if [[ -f "${package_list}" ]]; then
				cat "${package_list}" >> "${ISO_RSYNC_TARGET}/ISO_Installed_Packages"
			else
				ewarn "Package list not found: ${package_list}"
			fi
		done
		
		if [[ -f "${ISO_RSYNC_TARGET}/ISO_Installed_Packages" ]]; then
			mapfile -t iso_packages < "${ISO_RSYNC_TARGET}/ISO_Installed_Packages"
			
			if [[ ${#iso_packages[@]} -gt 0 ]]; then
				einfo "Installing ${#iso_packages[@]} packages..."
				chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "emerge -q ${iso_packages[*]}"
			else
				ewarn "No packages found in provided lists"
			fi
		fi
		
		# Cleanup
		chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "umount -f /mnt/argent_efipart/dev/* 2>/dev/null || true"
		chroot "${ISO_RSYNC_TARGET}" su - "${ISO_CHROOT_USER}" -c "env-update"
	fi
}

iso_rootfs_build() {
    einfo "========================================"
    einfo "PREPARING ISO IMAGE LAYOUT"
    einfo "========================================"
    
    # Create ISO directory structure
    local iso_directories=(
        "${ISO_RSYNC_TARGET}"
        "${ISO_RSYNC_SOURCE}"
        "${ISO_CDROOT_DIR}"
        "${ISO_SQUASHFS_DIR}"
        "${ISO_REALFS_DIR}"
        "${ISO_GRUB_DIR}"
        "${ISO_EFI_DIR}"
    )
    
    for dir in "${iso_directories[@]}"; do
        mkdir -p "${dir}"
    done
    
    local image_size=20480
    
    einfo "Creating base filesystem image (${image_size}MB / 20GiB)..."
    dd if=/dev/zero of="${ISO_RSYNC_TARGET}.img" bs=1M count="${image_size}" status=progress \
        || die "Could not create ${ISO_RSYNC_TARGET}.img"
    mkfs.ext4 -F -m 0 "${ISO_RSYNC_TARGET}.img" || die "mkfs.ext4 failed on ${ISO_RSYNC_TARGET}.img"

    einfo "Mounting core squashfs and syncing contents..."
    mount -t squashfs "${CORE_SQUASHFS}" "${ISO_RSYNC_SOURCE}" || die "Could not mount ${CORE_SQUASHFS}"
    mount -t ext4 "${ISO_RSYNC_TARGET}.img" "${ISO_RSYNC_TARGET}" || die "Could not mount ${ISO_RSYNC_TARGET}.img"

    einfo "Syncing filesystem contents..."
    if rsync -aHAXr --inplace --no-whole-file "${ISO_RSYNC_SOURCE}/" "${ISO_RSYNC_TARGET}/"; then
        einfo "Filesystem sync completed successfully"
    else
        eerror "Failed to sync filesystem contents"
        exit 1
    fi
    
    einfo "Preparing kernel for live boot..."
    if [[ ! -f "${ISO_RSYNC_TARGET}/boot/${ISO_KERNEL_NAME}" ]]; then
        die "Kernel ${ISO_KERNEL_NAME} not found in ${CORE_SQUASHFS}, set KERNEL_VERSION to a kernel the core squashfs contains"
    fi
    einfo "Using existing kernel..."
    cp -avx "${ISO_RSYNC_TARGET}/boot/${ISO_KERNEL_NAME}" "${ISO_ROOT_DIR}/boot/vmlinuz"
    
    einfo "Setting up portage configuration in chroot..."
    iso_mount
    iso_tree_sync
    iso_umount
    
    einfo "Generating initramfs for live boot..."
    iso_mount
    iso_initrd_gen
    local ramfs_rc=$?
    iso_umount

    if [[ ${ramfs_rc} -ne 0 ]]; then
        eerror "dracut exited ${ramfs_rc} while generating the live initramfs"
        isoumountall
        exit 1
    elif [[ -f "${ISO_RSYNC_TARGET}/boot/${ISO_RAMFS_NAME}" ]]; then
        einfo "Moving initramfs to final location..."
        mv "${ISO_RSYNC_TARGET}/boot/${ISO_RAMFS_NAME}" "${ISO_ROOT_DIR}/boot/initrd"
    else
        eerror "Failed to generate initramfs"
        exit 1
    fi
    
    einfo "Generating EFI bootloader..."
    iso_mount
    iso_efi_gen
    iso_umount
    
    if [[ -e "${ISO_RSYNC_TARGET}/root/bootx64.efi" ]]; then
        mv "${ISO_RSYNC_TARGET}/root/bootx64.efi" "${ISO_EFI_DIR}/"
        chmod 755 "${ISO_EFI_DIR}/bootx64.efi"
        einfo "EFI bootloader installed successfully"
    else
        ewarn "EFI bootloader not generated - you may need to create it manually"
    fi
    
    einfo "Generating GRUB chainloader..."
    iso_mount
    iso_grubcore_gen
    iso_umount
    
    if [[ -e "${ISO_RSYNC_TARGET}/root/core.img" ]]; then
        mv "${ISO_RSYNC_TARGET}/root/core.img" "${ISO_GRUB_DIR}/"
        einfo "GRUB chainloader installed successfully"
    else
        ewarn "GRUB chainloader not generated - you may need to create it manually"
    fi
    
    # Copy additional GRUB files
    if [[ -e "${ISO_RSYNC_TARGET}/usr/lib/grub/i386-pc/lnxboot.img" ]]; then
        cp -avx "${ISO_RSYNC_TARGET}/usr/lib/grub/i386-pc/lnxboot.img" "${ISO_GRUB_DIR}/"
    else
        ewarn "lnxboot.img not found - some boot features may not work"
    fi
    
    einfo "Installing packages and configuring ISO environment..."
    iso_mount
    isoinstallmask
    iso_customize "$@"
    isoinstallmaskremove
    isoosrelease
    isoupdatedone
    iso_umount
    
    iso_mount
    iso_units_enable
    iso_umount
    
    einfo "Finalizing ISO filesystem..."
    isozerofree

    # Move real filesystem to proper location
    mv "${ISO_RSYNC_TARGET}.img" "${ISO_REALFS_DIR}/rootfs.img"
    
    einfo "Creating compressed squashfs overlay..."
    mksquashfs "${ISO_CDROOT_DIR}" "${ISO_ROOT_DIR}/squashfs.img" \
        -b 1048576 -comp xz -Xdict-size 100% -Xbcj x86 \
        -no-duplicates -no-recovery || die "mksquashfs failed"
    mv "${ISO_ROOT_DIR}/squashfs.img" "${ISO_SQUASHFS_DIR}/"
    
    einfo "========================================"
    einfo "ISO PREPARATION COMPLETE"
    einfo "========================================"
    einfo "Filesystem structure:"
    einfo "- Real filesystem: ${ISO_REALFS_DIR}/rootfs.img"
    einfo "- Compressed overlay: ${ISO_SQUASHFS_DIR}/squashfs.img"
    einfo "- Boot files: ${ISO_ROOT_DIR}/boot/"
    einfo "========================================"
}

iso_bootcfg_fetch() {
	einfo "Fetching GRUB2 boot configuration..."
	
	if git clone "https://gitlab.com/${ARGENT_EDITION_NAME}/boot-core.git" "${BOOTLOADER_FETCH_PATH}"; then
		if [[ -d "${BOOTLOADER_CONFIGS}" ]]; then
			cp -avx "${BOOTLOADER_CONFIGS}" "${ISO_ROOT_DIR}/"
			einfo "Boot configuration installed successfully"
		else
			ewarn "Boot configuration directory not found in repository"
		fi
	else
		eerror "Failed to fetch boot configuration repository"
		exit 1
	fi
}

iso_cleaning() {
	einfo "Cleaning up temporary files..."
	
	local cleanup_targets=(
		"${ISO_RSYNC_SOURCE}"
		"${ISO_RSYNC_TARGET}"
		"${ISO_CDROOT_DIR}"
		"${BOOTLOADER_FETCH_PATH}"
	)
	
	# Unmount any remaining mounts
	isoumountall

	# Remove temporary directories
	for target in "${cleanup_targets[@]}"; do
		if [[ -d "${target}" ]]; then
			rm -rf "${target}"
		fi
	done
	
	einfo "Cleanup completed"
}

iso_image_write() {
	# Create final ISO image
	local iso_filename="${ARGENT_EDITION_NAME}-${ARGENT_RELEASE_TARGET}-${ARGENT_RELEASE_VERSION}-${ISO_ARCH}.iso"
	
	einfo "========================================"
	einfo "CREATING FINAL ISO IMAGE"
	einfo "========================================"
	einfo "Output file: ${iso_filename}"
	
	if grub-mkrescue \
		--mbr-force-bootable \
		-volid "ARGENT" \
		-joliet \
		-iso-level 3 \
		-o "${iso_filename}" \
		"${ISO_ROOT_DIR}"; then
		
		einfo "========================================"
		einfo "ISO CREATION SUCCESSFUL!"
		einfo "========================================"
		einfo "ISO file: ${iso_filename}"
		einfo "Size: $(du -h "${iso_filename}" | cut -f1)"
		einfo "========================================"
	else
		eerror "Failed to create ISO image"
		exit 1
	fi
}

iso_build() {
	einfo "========================================"
	einfo "STARTING ISO CREATION PROCESS"
	einfo "========================================"
	
	verify_root_priv
	kernel_check
	checksum_chroot_verify
	trap isoumountall EXIT INT TERM
	iso_rootfs_build "$@" || return 1
	iso_bootcfg_fetch || return 1
	iso_cleaning
	iso_image_write || return 1

	einfo "========================================"
	einfo "ISO CREATION COMPLETED SUCCESSFULLY"
	einfo "========================================"
}

