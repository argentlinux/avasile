wipe_repo_tree() {
	find "${1}" -mindepth 1 -maxdepth 1 ! -name packages ! -name distfiles -exec rm -rf {} +
}

remove_gentoo_tree() {
	# Remove portage tree while preserving packages and distfiles
	[[ -d "${PORTAGE_MAIN_DIR}/.git" ]] || return 0
	einfo "Removing Gentoo portage tree (preserving packages and distfiles)"
	wipe_repo_tree "${PORTAGE_MAIN_DIR}"
}

remove_argent_overlay() {
	# Remove Argent overlay
	einfo "Removing ${ARGENT_EDITION_NAME}-${ARGENT_RELEASE_TARGET} overlay"

	if command -v layman >/dev/null 2>&1; then
		layman -d "${ARGENT_EDITION_NAME}-${ARGENT_RELEASE_TARGET}" >/dev/null 2>&1
		rm -rf "/var/lib/layman/${ARGENT_EDITION_NAME}-${ARGENT_RELEASE_TARGET}" || die "Failed to remove layman directory"
	elif [[ -d "${ARGENT_MAIN_DIR}/.git" ]]; then
		einfo "Removing Argent overlay tree (preserving packages and distfiles)"
		wipe_repo_tree "${ARGENT_MAIN_DIR}"
	fi
}

remove_portage_config() {
	# Remove Argent build system configuration
	einfo "Removing ${ARGENT_EDITION_NAME}-${ARGENT_RELEASE_TARGET} build system"
	
	local config_files=(
		"${PORTAGE_LINK_CONFDIR}/make.profile"
		"${PORTAGE_LINK_CONFDIR}"
	)

	rm -rf "${PORTAGE_LINK_CONFDIR}/make.conf" >/dev/null 2>&1

	for config_file in "${config_files[@]}"; do
		rm -f "${config_file}" >/dev/null 2>&1
	done
	
	rm -rf "${PORTAGE_MAIN_CONFDIR}" >/dev/null 2>&1
}

clear_mode() {
	# Reset system to clean state
	verify_root_priv
	remove_gentoo_tree || return 1
	remove_argent_overlay || return 1
	remove_portage_config
}

fetch_build_config() {
	# Fetch Argent build system configuration
	einfo "Injecting ${ARGENT_EDITION_NAME}-${ARGENT_RELEASE_TARGET} build system"
	git clone --branch "${AVASILE_BRANCH:-master}" "${PORTAGE_REPO}" "${PORTAGE_MAIN_CONFDIR}"
}

fetch_gentoo_tree_full() {
	# Fetch complete Gentoo portage tree for development/source modes
	if [[ ! -d "${PORTAGE_MAIN_DIR}/.git" ]]; then
		einfo "Injecting full Gentoo portage tree (devmode/srcmode)"
		
		# Ensure directory exists
		mkdir -p "${PORTAGE_MAIN_DIR}"
		
		cd "${PORTAGE_MAIN_DIR}" || exit 1
		git init >/dev/null 2>&1
		git remote add -t "${AVASILE_BRANCH:-master}" origin https://gitlab.com/argent/portage.git

		einfo "Fetching portage tree (this may take a while)..."
		git fetch --depth=1 origin "${AVASILE_BRANCH:-master}" || return 1
		git checkout -B "${AVASILE_BRANCH:-master}" --track "origin/${AVASILE_BRANCH:-master}" || return 1
		
		# Clean up unnecessary files
		rm -rf "${PORTAGE_MAIN_DIR}/profiles/updates"
		
		einfo "Full portage tree installation completed"
	else
		einfo "Full portage tree already exists, skipping..."
	fi
}

fetch_portage_config_git() {
	# Fetch complete Argent build directory for development
	if [[ ! -e "${PORTAGE_MAIN_CONFDIR}/.git" ]]; then
		echo
		einfo "Injecting GIT sync to central Argent overlay..."
		einfo "This may take a moment, please stand by!"
		
		mkdir -p "${PORTAGE_MAIN_CONFDIR}"
		cd "${PORTAGE_MAIN_CONFDIR}" || exit 1
		
		git init >/dev/null 2>&1
		git remote add -t "${AVASILE_BRANCH:-master}" origin "${PORTAGE_REPO}"
		git fetch --depth=1 origin "${AVASILE_BRANCH:-master}" || return 1
		git checkout -B "${AVASILE_BRANCH:-master}" --track "origin/${AVASILE_BRANCH:-master}" || return 1
		
		einfo "Argent build directory sync completed"
	else
		einfo "Argent build directory already exists, skipping..."
	fi
}

fetch_gentoo_tree_minimal() {
    # Fetch minimal portage tree for user mode
    # Only includes profiles, metadata, and eclasses - no ebuilds
    if [[ ! -d "${PORTAGE_MAIN_DIR}" ]]; then
        mkdir -p "${PORTAGE_MAIN_DIR}"
    fi

    if [[ ! -d "${PORTAGE_MAIN_DIR}/.git" ]]; then
        einfo "Injecting minimal Gentoo portage tree (usermode)"
        einfo "This includes only profiles, metadata, and eclasses"

        cd "${PORTAGE_MAIN_DIR}" || exit 1
        git init >/dev/null 2>&1
        git remote add -t "${AVASILE_BRANCH:-master}" origin https://gitlab.com/argent/portage.git

        # Use partial cloning to save space
        git config core.sparseCheckout true
        git config extensions.partialClone origin
        git config remote.origin.promisor true
        git config remote.origin.partialCloneFilter blob:none

        git fetch --depth=1 --filter=blob:none origin "${AVASILE_BRANCH:-master}" || return 1
        git checkout -f -B "${AVASILE_BRANCH:-master}" --track "origin/${AVASILE_BRANCH:-master}" || return 1

        git sparse-checkout init --cone
        git sparse-checkout set profiles metadata eclass
        
        echo ".gitignore" >> .git/info/sparse-checkout
        git read-tree -m -u HEAD

        git reflog expire --expire=now --all
        git gc --prune=now --aggressive
        
        rm -rf .git/hooks/*
        
        rm -rf profiles/updates profiles/desc profiles/arch/*/use.* 2>/dev/null
        find profiles/default/linux/ -mindepth 1 -maxdepth 1 -type d ! -name amd64 -exec rm -rf {} + 2>/dev/null
        
        find metadata/ -name "*.xml" ! -name "layout.conf" -delete 2>/dev/null

        einfo "Minimal portage tree installation completed"
    else
        einfo "Minimal portage tree already exists, skipping..."
    fi
}

fetch_argent_overlay_minimal() {
    # Fetch minimal Argent overlay tree for user mode
    # Only includes profiles, metadata, and eclasses
    if [[ ! -d "${ARGENT_MAIN_DIR}" ]]; then
        mkdir -p "${ARGENT_MAIN_DIR}"
    fi

    if [[ ! -d "${ARGENT_MAIN_DIR}/.git" ]]; then
        einfo "Injecting minimal Argent overlay tree (usermode)"

        cd "${ARGENT_MAIN_DIR}" || exit 1
        git init >/dev/null 2>&1
        git remote add -t "${AVASILE_BRANCH:-master}" origin https://gitlab.com/argent/argent-ws.git

        git config core.sparseCheckout true
        git config extensions.partialClone origin
        git config remote.origin.promisor true
        git config remote.origin.partialCloneFilter blob:none

        git fetch --depth=1 --filter=blob:none origin "${AVASILE_BRANCH:-master}" || return 1
        git checkout -f -B "${AVASILE_BRANCH:-master}" --track "origin/${AVASILE_BRANCH:-master}" || return 1

        # Configure sparse checkout properly
        git sparse-checkout init --cone
        git sparse-checkout set profiles metadata eclass
        echo ".gitignore" >> .git/info/sparse-checkout
        git read-tree -m -u HEAD

        # Skip submodules for minimal mode - they're not needed

        git reflog expire --expire=now --all
        git gc --prune=now --aggressive
        
        rm -rf .git/hooks/*
        
        rm -rf profiles/updates 2>/dev/null

        einfo "Minimal Argent overlay tree installation completed"
    else
        einfo "Minimal Argent overlay tree already exists, skipping..."
    fi
}

fetch_argent_overlay() {
	# Fetch Argent overlay using appropriate method
	einfo "Injecting ${ARGENT_EDITION_NAME}-${ARGENT_RELEASE_TARGET} overlay"

	if command -v layman >/dev/null 2>&1; then
		# Use layman if available
		local overlay_url="https://gitlab.com/${ARGENT_EDITION_NAME}/${ARGENT_EDITION_NAME}-${ARGENT_RELEASE_TARGET}/raw/master/overlay.xml"
		echo y | layman -f -a "${ARGENT_EDITION_NAME}-${ARGENT_RELEASE_TARGET}" -o "${overlay_url}"
	else
		# Use emerge --sync as fallback
		emerge --sync "${ARGENT_EDITION_NAME}-${ARGENT_RELEASE_TARGET}"
	fi
}

# ============================================================================
# System Mode Configuration Functions
# ============================================================================

repo_branch() {
	local repo="${1}" upstream current

	upstream="$(git -C "${repo}" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)"
	if [[ -n "${upstream}" ]] ; then
		echo "${upstream#*/}"
		return
	fi

	current="$(git -C "${repo}" symbolic-ref --quiet --short HEAD 2>/dev/null)"
	echo "${current:-master}"
}

checkout_branch() {
	local repo="${1}" branch="${2}" force="${3}"
	local -a fetch_opts=() checkout_opts=()

	[[ "$(git -C "${repo}" rev-parse --is-shallow-repository 2>/dev/null)" == "true" ]] && fetch_opts+=( --depth=1 )
	[[ "${force}" == "--force" ]] && checkout_opts+=( -f )

	git -C "${repo}" remote set-branches origin "${branch}" || return 1
	git -C "${repo}" fetch "${fetch_opts[@]}" origin "+refs/heads/${branch}:refs/remotes/origin/${branch}" || return 1
	git -C "${repo}" checkout "${checkout_opts[@]}" -B "${branch}" --track "origin/${branch}" || return 1

	if [[ -e "${repo}/.gitmodules" ]] ; then
		git -C "${repo}" submodule update --recursive --depth=1 || return 1
	fi
}

restore_branch() {
	local repo="${1}" ref="${2}" upstream="${3}"

	ewarn "Restoring ${repo} to ${ref}"
	git -C "${repo}" remote set-branches origin "${upstream}"
	git -C "${repo}" checkout -f "${ref}" > /dev/null 2>&1 || eerror "Could not restore ${repo}, fix it by hand or set up a mode again"
}

switch_repo_branch() {
	local target="${AVASILE_BRANCH}" force="" arg repo failed=0 dirty=0 i
	local -a selected=() repos=() touched=() from_ref=() from_upstream=()
	local usage="Usage: avasile --branch master|dev [gentoo] [argent-ws] [argentws-build] [--force]"

	for arg in "$@" ; do
		case "${arg}" in
			--force) force="--force" ;;
			gentoo) selected+=( "${PORTAGE_MAIN_DIR}" ) ;;
			argent-ws) selected+=( "${ARGENT_MAIN_DIR}" ) ;;
			argentws-build) selected+=( "${PORTAGE_MAIN_CONFDIR}" ) ;;
			*)
				eerror "Unknown repository or option: ${arg}"
				eerror "${usage}"
				return 1
				;;
		esac
	done

	if [[ ${#selected[@]} -gt 0 ]] ; then
		for repo in "${selected[@]}" ; do
			if [[ ! -d "${repo}/.git" ]] ; then
				eerror "${repo} is not a git repository"
				return 1
			fi
			repos+=( "${repo}" )
		done
	else
		for repo in "${PORTAGE_MAIN_DIR}" "${ARGENT_MAIN_DIR}" "${PORTAGE_MAIN_CONFDIR}" ; do
			if [[ ! -d "${repo}/.git" ]] ; then
				ewarn "${repo} is not a git repository, skipping it"
				continue
			fi
			repos+=( "${repo}" )
		done
	fi

	if [[ ${#repos[@]} -eq 0 ]] ; then
		eerror "No git repositories found, set up a mode first"
		return 1
	fi

	einfo "Checking repositories before switching to ${target}"
	for repo in "${repos[@]}" ; do
		if [[ -e "${repo}/.git/MERGE_HEAD" || -d "${repo}/.git/rebase-merge" || -d "${repo}/.git/rebase-apply" ]] ; then
			eerror "${repo} has a merge or rebase in progress"
			failed=1
			continue
		fi

		if ! git -C "${repo}" ls-remote --exit-code --heads origin "${target}" > /dev/null 2>&1 ; then
			eerror "${repo}: branch ${target} not found on origin (or origin is unreachable)"
			failed=1
			continue
		fi

		if [[ "${force}" != "--force" && -n "$(git -C "${repo}" status --porcelain --untracked-files=no --ignore-submodules=all)" ]] ; then
			eerror "${repo} has local changes:"
			git -C "${repo}" status --short --untracked-files=no --ignore-submodules=all
			dirty=1
			failed=1
		fi
	done

	if [[ ${failed} -eq 1 ]] ; then
		eerror "Nothing was changed"
		[[ ${dirty} -eq 1 ]] && eerror "Commit or drop the local changes, or use --force to discard them"
		return 1
	fi

	for repo in "${repos[@]}" ; do
		if [[ "$(git -C "${repo}" symbolic-ref --quiet --short HEAD 2>/dev/null)" == "${target}" && "$(repo_branch "${repo}")" == "${target}" ]] ; then
			einfo "${repo} is already on ${target}"
			continue
		fi

		touched+=( "${repo}" )
		from_ref+=( "$(git -C "${repo}" symbolic-ref --quiet --short HEAD 2>/dev/null || git -C "${repo}" rev-parse HEAD)" )
		from_upstream+=( "$(repo_branch "${repo}")" )

		einfo "Switching ${repo} from ${from_upstream[-1]} to ${target}"
		if ! checkout_branch "${repo}" "${target}" "${force}" ; then
			eerror "Switching ${repo} failed, putting every repository back"
			for (( i=${#touched[@]}-1 ; i>=0 ; i-- )) ; do
				restore_branch "${touched[i]}" "${from_ref[i]}" "${from_upstream[i]}"
			done
			return 1
		fi
	done

	einfo "All repositories now follow ${target}"
	einfo "Going back to an older branch can make emerge downgrade packages, that is expected"
}

refresh_pkg_keys() {
	[[ "${AVASILE_SKIP_KEYS:-0}" == "1" ]] && return 0
	if command -v getuto > /dev/null 2>&1 ; then
		getuto || ewarn "getuto could not refresh the binpkg signature keyring"
	fi
}

regen_pkg_keys() {
	einfo "Regenerating /etc/portage/gnupg (binpkg signature keyring)"
	rm -rf /etc/portage/gnupg
	if command -v getuto > /dev/null 2>&1 ; then
		getuto -v
	else
		eerror "app-portage/getuto not found; cannot regenerate keyring"
		return 1
	fi
}

apply_mode_config() {
	local conf="${1}" scope="${2}"

	if [[ "${scope}" == "central" ]]; then
		ln -sf "${PORTAGE_GITDIR}" "${PORTAGE_LINK_CONFDIR}"
	fi
	set_make_conf_symlink "${conf}"
	if [[ "${scope}" == "decentral" ]]; then
		ln -sf "${PORTAGE_LINK_CONFDIR}/binhost-main.conf" "${PORTAGE_LINK_CONFDIR}/binhost.conf"
	fi

	# Set appropriate Gentoo profile
	eselect profile set "${PORTAGE_PROFILE}" || return 1

	# Update env cache and source everything back to profile
	regenerate_cache

	if [[ "${scope}" == "decentral" || "${conf}" != "make.conf.amd64-user" ]]; then
		ensure_make_conf_local
	fi
	if [[ "${scope}" == "central" ]]; then
		refresh_pkg_keys
	fi
}

make_custom_conf() {
	if [[ ! -e "${PORTAGE_GITDIR}/make.conf.amd64-custom" ]]; then
		cp "${PORTAGE_GITDIR}/make.conf.amd64-devel" "${PORTAGE_GITDIR}/make.conf.amd64-custom"
	fi
}

# ============================================================================
# Primary System Mode Functions
# ============================================================================

check_portage_directory() {
	local current_dir
	current_dir=$(pwd)
	
	if [[ "${current_dir}" == "/etc/portage"* ]]; then
		ewarn "You are currently in the /etc/portage directory"
		ewarn "This directory will be modified during mode switching"
		einfo "Changing to /etc/ directory for safety..."
		cd /etc/ || {
			eerror "Failed to change to /etc/ directory"
			exit 1
		}
		einfo "Directory changed to: $(pwd)"
	fi
}

setup_mode() {
	local mode="${1}"
	local name="${AVASILE_MODE_NAME[${mode}]}"

	verify_root_priv
	einfo "Setting up ${name}"

	check_portage_directory
	clear_mode || return 1
	fetch_build_config || return 1

	if [[ "${mode}" == "binpkgmode" ]]; then
		fetch_gentoo_tree_minimal || return 1
		fetch_argent_overlay_minimal || return 1
	else
		fetch_gentoo_tree_full || return 1
	fi

	if [[ "${mode}" == "srccustom" ]]; then
		make_custom_conf

		# Clean up git history for custom configuration
		rm -rf "${PORTAGE_MAIN_CONFDIR}/.git"

		# Remove default package configuration
		rm -rf "${PORTAGE_GITDIR}/package.accept_keywords/"*
		rm -rf "${PORTAGE_GITDIR}/package.use/"*
	fi

	apply_mode_config "${AVASILE_MODE_CONF[${mode}]}" central || return 1

	if [[ "${mode}" != "binpkgmode" ]]; then
		fetch_argent_overlay || return 1
	fi

	if [[ -n "${AVASILE_BRANCH}" ]]; then
		switch_repo_branch || return 1
	fi

	einfo "Finished setting up ${name}"
}


# ============================================================================
# Decentralized Mode Functions
# ============================================================================

decentralized_mode() {
	local mode="${1}"
	local name="${AVASILE_MODE_NAME[${mode}]}"

	einfo "Configuring decentralized ${name}"

	if [[ ! -e "${PORTAGE_MAIN_CONFDIR}" ]]; then
		ewarn "Clone directory not found: ${PORTAGE_MAIN_CONFDIR}"
		return 1
	fi

	if [[ "${mode}" == "srccustom" ]]; then
		make_custom_conf
	fi
	apply_mode_config "${AVASILE_MODE_CONF[${mode}]}" decentral || return 1
	einfo "Decentralized ${name} configured"
}

decentralized_gentoo() {
	# Configure pure Gentoo mode - complete independence from Argent
	ewarn "Configuring pure Gentoo mode (one-way operation!)"

	decentralized_mode srccustom
	
	# Remove Argent-specific git configuration
	rm -rf "${PORTAGE_LINK_CONFDIR}/.git"
	
	# Clean up Argent-specific package configurations
	local gitignore_keywords="${PORTAGE_MAIN_CONFDIR}/conf/intel/portage/package.accept_keywords/.gitignore"
	local gitignore_use="${PORTAGE_MAIN_CONFDIR}/conf/intel/portage/package.use/.gitignore"
	
	if [[ -f "${gitignore_keywords}" ]]; then
		sed -i 's|!||g' "${gitignore_keywords}"
		while IFS= read -r keyword_file; do
			if [[ "${keyword_file}" == *"keyword"* ]]; then
				rm -f "${PORTAGE_MAIN_CONFDIR}/conf/intel/portage/package.accept_keywords/${keyword_file}"
			fi
		done < "${gitignore_keywords}"
	fi
	
	if [[ -f "${gitignore_use}" ]]; then
		sed -i 's|!||g' "${gitignore_use}"
		while IFS= read -r use_file; do
			if [[ "${use_file}" == *"use"* ]]; then
				rm -f "${PORTAGE_MAIN_CONFDIR}/conf/intel/portage/package.use/${use_file}"
			fi
		done < "${gitignore_use}"
	fi
	
	einfo "Pure Gentoo mode configured"
	einfo "System is now completely independent from Argent"
}
