# Overlay Mount Directories
export READ_ONLY_DIR="rodir"
export READ_WRITE_DIR="rwdir"
export WORK_DIR="workdir"
export OVERLAY_DIR="overlaydir"

# Build Environment Variables
export BUILD_CHROOT_USER="root"
export BUILD_SOURCE_SETUP="avasile --srcmode"

# ISO Creation Variables
export ISO_CHROOT_USER="root"
export ISO_ARCH="x86_64"
export ISO_BINARY_SETUP="avasile --usermode"
export ISO_KERNEL_NAME="kernel-genkernel-${ISO_ARCH}-${KERNEL_RELEASE_VER}"
export ISO_RAMFS_NAME="initramfs-genkernel-${ISO_ARCH}-${KERNEL_RELEASE_VER}"

# ISO Commands
export ISO_RAMFS_CMD="dracut -N -a dmsquash-live -a pollcdrom -a mdraid \
    -o systemd -o systemd-initrd -o systemd-networkd -o dracut-systemd \
    -o btrfs -o crypt -o i18n -o usrmount -o lunmask -o nvdimm -o multipath \
    --omit-drivers nouveau \
    --force --kver ${KERNEL_RELEASE_VER} /boot/${ISO_RAMFS_NAME}"

export ISO_EFI_CMD="grub-mkimage -d /usr/lib/grub/x86_64-efi -o bootx64.efi \
    -O x86_64-efi ext2 fat udf btrfs ntfs reiserfs xfs hfsplus lvm ata \
    part_msdos part_gpt part_apple bsd search_fs_uuid normal chain iso9660 \
    configfile help loadenv reboot cat search memdisk tar boot linux chain \
    -p /boot/grub"

export ISO_CHAINLOAD_CMD="grub-mkimage -d /usr/lib/grub/i386-pc -o core.img \
    -O i386-pc biosdisk part_msdos fat -p /boot/grub"

# ISO Directory Layout
export BOOTLOADER_FETCH_PATH="/tmp/bootcore"
export BOOTLOADER_CONFIGS="${BOOTLOADER_FETCH_PATH}/cdroot/boot"
export ISO_ROOT_DIR="${ARGENT_EDITION_NAME}-${ARGENT_RELEASE_TARGET}-${ARGENT_RELEASE_VERSION}-${ISO_ARCH}"
