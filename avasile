#
# =============================================================================

# Variables and functions come from libavasile

export AVASILE_VERBOSE="${AVASILE_VERBOSE:-0}"
if [[ "${AVASILE_VERBOSE}" -eq 1 ]]; then
	set -x
fi

source /lib64/avasile/libavasile

# Avasile need root privileges and a proper kernel to run
# It also refuses to run on a live ISO

live_check

AVASILE_ARGV=( "$@" )
export AVASILE_SKIP_KEYS="${AVASILE_SKIP_KEYS:-0}"
export AVASILE_BRANCH="${AVASILE_BRANCH:-}"
_avasile_args=()
while [[ $# -gt 0 ]]; do
	case "$1" in
		--skip-keys|--no-keys) AVASILE_SKIP_KEYS=1 ;;
		--branch)
			if [[ -z "$2" || "$2" == --* ]]; then
				eerror "error: --branch needs a branch name, e.g. --branch dev"
				exit 1
			fi
			AVASILE_BRANCH="$2"
			shift
			;;
		--branch=*) AVASILE_BRANCH="${1#--branch=}" ;;
		*) _avasile_args+=("$1") ;;
	esac
	shift
done
set -- "${_avasile_args[@]}"

declare -A _avasile_ops=(
	[--status]="checkmode"
	[--makepkg]="chroot_pkg_build"
	[--makeiso]="iso_build"
	[--resetmode]="clear_mode"
	[--regen-keys]="regen_pkg_keys"
	[--usermode]="setup_mode binpkgmode"
	[--devmode]="setup_mode mixedbinsrc"
	[--srcmode]="setup_mode srcmode"
	[--custom]="setup_mode srccustom"
	[--decentralize-user]="decentralized_mode binpkgmode"
	[--decentralize-dev]="decentralized_mode mixedbinsrc"
	[--decentralize-source]="decentralized_mode srcmode"
	[--decentralize-custom]="decentralized_mode srccustom"
	[--decentralize-gentoo]="decentralized_gentoo"
	[--help]="print_usage"
)

if [[ -n "${1}" && -n "${_avasile_ops[${1}]}" ]]; then
	read -r -a _avasile_op <<< "${_avasile_ops[${1}]}"
	shift
	"${_avasile_op[@]}" "$@"
elif [[ -n "${AVASILE_BRANCH}" ]]; then
	verify_root_priv
	switch_repo_branch "$@"
else
	eerror "error: no operation specified, use --help for help"
	exit 1
fi

exit $?
